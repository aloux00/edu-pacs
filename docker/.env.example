# EduPACS Docker 部署环境变量模板
# 复制为 .env 后填写；内网用户直接运行 deploy-offline.sh 会自动生成随机凭据，无需手工填。
# 说明：本凭据是 app 容器反向代理访问 Orthanc 的服务账号（Basic 认证），
#      与师生登录账号（admin/teacher01/...）无关。

# Orthanc 服务账号（两侧联动：ORTHANC__REGISTERED_USERS 与 ORTHANC_AUTH_USER/PASS）
EDUPACS_ORTHANC_USER=edupacs_service
EDUPACS_ORTHANC_PASS=请改成强密码

# 可选：覆盖镜像（默认与离线包一致）
# ORTHANC_IMAGE=orthancteam/orthanc:26.9.1
# EDUPACS_APP_IMAGE=edupacs-app:1.0.0

# 加密备份归档的宿主机目录（默认 compose 文件同级的 ./backups）
# 异机备份：先挂载 NFS/共享目录，再指向它，例如：
# BACKUP_DIR=/mnt/nfs/edupacs-backups
BACKUP_DIR=./backups
