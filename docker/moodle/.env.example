# EduPACS + Moodle 一键集成栈配置模板
# configure.py --init 会在首次启动时自动生成 .env 并填入随机密码/凭据。
# 修改任何值后，用「一键停止.bat」再「一键启动.bat」重建生效。

# 浏览器访问地址（局域网部署时把 localhost 改成服务器 IP）
MOODLE_PORT=8080
EDUPACS_PORT=8000
DICOM_PORT=4242
MOODLE_PUBLIC_HOST=localhost:8080
EDUPACS_PUBLIC_HOST=localhost:8000

# 镜像（国内网络可自行改成已缓存镜像名）
MOODLE_IMAGE=docker.io/bitnami/moodle:4.5
MARIADB_IMAGE=docker.io/bitnami/mariadb:11.2
ORTHANC_IMAGE=orthancteam/orthanc:26.9.1
PYTHON_IMAGE=python:3.12-slim
EDUPACS_APP_IMAGE=edupacs-moodle-app:1.0.0

# Moodle 站点与数据库
MOODLE_SITE_NAME=EduPACS 教学平台
MOODLE_LANG=zh_cn
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=CHANGE_ME
MOODLE_ADMIN_EMAIL=admin@example.local
MOODLE_DB_NAME=bitnami_moodle
MOODLE_DB_USER=bn_moodle
MOODLE_DB_PASS=CHANGE_ME
MARIADB_ROOT_PASS=CHANGE_ME

# Moodle 中自动创建的课程与演示账号
MOODLE_COURSE_FULLNAME=EduPACS 医学影像诊断学
MOODLE_COURSE_SHORTNAME=EduPACS2026
DEMO_TEACHER_USER=teacher1
DEMO_TEACHER_PASS=CHANGE_ME
DEMO_STUDENT_USER=student1
DEMO_STUDENT_PASS=CHANGE_ME

# EduPACS / Orthanc
EDUPACS_ORTHANC_USER=edupacs
EDUPACS_ORTHANC_PASS=CHANGE_ME

# LTI 1.3：client_id 由 configure.py 生成；deployment_id 由 Moodle 引导脚本回写
LTI_CLIENT_ID=CHANGE_ME

# xAPI：本地 LRS 的 Basic 认证头，由 configure.py 生成
XAPI_AUTH_HEADER=CHANGE_ME
